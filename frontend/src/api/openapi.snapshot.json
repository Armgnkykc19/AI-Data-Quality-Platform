          "NO_MATCH",
          "DEFERRED"
        ],
        "title": "ReviewEventType",
        "type": "string"
      },
      "ReviewResolutionRead": {
        "additionalProperties": false,
        "description": "The human decision already recorded against a case.\n\n``review_case_id`` is dropped because the enclosing response already\nidentifies the case, and ``machine_decision`` / ``machine_reason`` because\n``ReviewWorkflow`` copies them off the case when it builds the resolution --\nthey are already published one level up, and a second copy could only ever\nagree or reveal a bug.",
        "properties": {
          "downstream_action": {
            "title": "Downstream Action",
            "type": "string"
          },
          "human_decision": {
            "$ref": "#/components/schemas/HumanReviewDecision"
          },
          "resolution_sequence": {
            "title": "Resolution Sequence",
            "type": "integer"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          }
        },
        "required": [
          "human_decision",
          "reviewer_id",
          "resolution_sequence",
          "downstream_action"
        ],
        "title": "ReviewResolutionRead",
        "type": "object"
      },
      "ReviewStatus": {
        "enum": [
          "PENDING",
          "MATCH",
          "NO_MATCH",
          "DEFERRED"
        ],
        "title": "ReviewStatus",
        "type": "string"
      },
      "SemanticFailureCode": {
        "enum": [
          "CONFIGURATION_ERROR",
          "PROVIDER_TIMEOUT",
