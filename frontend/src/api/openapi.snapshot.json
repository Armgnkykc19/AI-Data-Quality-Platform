{
  "components": {
    "schemas": {
      "BlockingReasonRead": {
        "additionalProperties": false,
        "description": "Why these two records were ever compared.\n\n``blocking_key`` is customer-derived: for the email and phone strategies it\nis a normalized email address or a phone fragment. It is published because a\nreviewer judging whether two records are the same person needs to know what\nput them in the same bucket, and withholding it would leave the decision\nunsupported. Treat it as personal data.",
        "properties": {
          "blocking_key": {
            "title": "Blocking Key",
            "type": "string"
          },
          "reason_type": {
            "title": "Reason Type",
            "type": "string"
          }
        },
        "required": [
          "reason_type",
          "blocking_key"
        ],
        "title": "BlockingReasonRead",
        "type": "object"
      },
      "ConflictingEvidenceRead": {
        "additionalProperties": false,
        "description": "One reason the records may not be the same entity.\n\nConflict descriptions are fixed sentences (\"Both records have different\nnon-empty email addresses.\"), so they name the disagreement without\nreproducing either value.",
        "properties": {
          "conflict_type": {
            "title": "Conflict Type",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "field_name": {
            "title": "Field Name",
            "type": "string"
          },
          "penalty": {
            "title": "Penalty",
            "type": "number"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "conflict_type",
          "field_name",
          "severity",
          "penalty",
          "description"
        ],
        "title": "ConflictingEvidenceRead",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "The complete health payload. One field, and it never grows.\n\n``status`` is typed as a literal rather than a free string because the only\nbody this endpoint may return is ``{\"status\": \"ok\"}``. An unhealthy process\ndoes not answer here at all -- it fails to start. See ``routes.health``.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HumanReviewDecision": {
        "enum": [
          "MATCH",
          "NO_MATCH",
          "DEFER"
        ],
        "title": "HumanReviewDecision",
        "type": "string"
      },
      "MatchDecisionType": {
        "enum": [
          "AUTO_MATCH",
          "REVIEW",
          "NO_MATCH"
        ],
        "title": "MatchDecisionType",
        "type": "string"
      },
      "ResolveReviewCaseRequest": {
        "additionalProperties": false,
        "description": "One human decision, as a reviewer submits it.",
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/HumanReviewDecision"
          },
          "expected_version": {
            "description": "The case version the reviewer had in front of them.",
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Unverified audit label. Not an authenticated identity.",
            "title": "Reviewer Id"
          }
        },
        "required": [
          "decision",
          "expected_version"
        ],
        "title": "ResolveReviewCaseRequest",
        "type": "object"
      },
      "ResolveReviewCaseResponse": {
        "additionalProperties": false,
        "description": "What the resolution produced, at the two levels a client needs.\n\n``case`` is the updated case: its new status, its new version, and the\nresolution the domain recorded. ``event`` is the history entry that was\nappended alongside it, so a client can extend its timeline without\nre-fetching.",
        "properties": {
          "case": {
            "$ref": "#/components/schemas/ReviewCaseDetail"
          },
          "event": {
            "$ref": "#/components/schemas/ReviewEventRead"
          }
        },
        "required": [
          "case",
          "event"
        ],
        "title": "ResolveReviewCaseResponse",
        "type": "object"
      },
      "ReviewCaseDetail": {
        "additionalProperties": false,
        "description": "Everything a reviewer needs to decide one case, and nothing else.\n\nThe thresholds are published because they are what make ``machine_score``\nlegible: a score of 0.81 means something only once a reader knows it fell\nbetween the review and AUTO_MATCH thresholds, which is the entire reason the\ncase exists.",
        "properties": {
          "auto_match_threshold": {
            "title": "Auto Match Threshold",
            "type": "number"
          },
          "blocking_reasons": {
            "items": {
              "$ref": "#/components/schemas/BlockingReasonRead"
            },
            "title": "Blocking Reasons",
            "type": "array"
          },
          "conflicting_evidence": {
            "items": {
              "$ref": "#/components/schemas/ConflictingEvidenceRead"
            },
            "title": "Conflicting Evidence",
            "type": "array"
          },
          "created_at_utc": {
            "title": "Created At Utc",
            "type": "string"
          },
          "human_summary": {
            "title": "Human Summary",
            "type": "string"
          },
          "machine_decision": {
            "$ref": "#/components/schemas/MatchDecisionType"
          },
          "machine_reason": {
            "title": "Machine Reason",
            "type": "string"
          },
          "machine_score": {
            "title": "Machine Score",
            "type": "number"
          },
          "missing_evidence_notes": {
            "items": {
              "type": "string"
            },
            "title": "Missing Evidence Notes",
            "type": "array"
          },
          "record_a_id": {
            "title": "Record A Id",
            "type": "string"
          },
          "record_b_id": {
            "title": "Record B Id",
            "type": "string"
          },
          "resolution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewResolutionRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_case_id": {
            "title": "Review Case Id",
            "type": "string"
          },
          "review_threshold": {
            "title": "Review Threshold",
            "type": "number"
          },
          "status": {
            "$ref": "#/components/schemas/ReviewStatus"
          },
          "supporting_evidence": {
            "items": {
              "$ref": "#/components/schemas/SupportingEvidenceRead"
            },
            "title": "Supporting Evidence",
            "type": "array"
          },
          "updated_at_utc": {
            "title": "Updated At Utc",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "review_case_id",
          "record_a_id",
          "record_b_id",
          "status",
          "machine_decision",
          "machine_score",
          "auto_match_threshold",
          "review_threshold",
          "machine_reason",
          "human_summary",
          "missing_evidence_notes",
          "blocking_reasons",
          "supporting_evidence",
          "conflicting_evidence",
          "resolution",
          "version",
          "created_at_utc",
          "updated_at_utc"
        ],
        "title": "ReviewCaseDetail",
        "type": "object"
      },
      "ReviewCaseListResponse": {
        "additionalProperties": false,
        "description": "A page of the queue.\n\n``total`` counts every case matching the filter, before slicing, so a client\ncan tell \"this page is empty\" from \"nothing matches\".",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReviewCaseSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "count",
          "total",
          "limit",
          "offset"
        ],
        "title": "ReviewCaseListResponse",
        "type": "object"
      },
      "ReviewCaseSummary": {
        "additionalProperties": false,
        "description": "One row of the reviewer's queue.\n\nEnough to identify the pair, read the machine's verdict and confidence, see\nwhere the case stands, and carry the version a later resolution will have to\necho back. Evidence is deliberately absent: it belongs to the decision\nscreen, and shipping it for every row would put the whole queue's\ncustomer-derived detail into one unauthenticated response.",
        "properties": {
          "created_at_utc": {
            "title": "Created At Utc",
            "type": "string"
          },
          "machine_decision": {
            "$ref": "#/components/schemas/MatchDecisionType"
          },
          "machine_score": {
            "title": "Machine Score",
            "type": "number"
          },
          "record_a_id": {
            "title": "Record A Id",
            "type": "string"
          },
          "record_b_id": {
            "title": "Record B Id",
            "type": "string"
          },
          "review_case_id": {
            "title": "Review Case Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ReviewStatus"
          },
          "updated_at_utc": {
            "title": "Updated At Utc",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "review_case_id",
          "record_a_id",
          "record_b_id",
          "status",
          "machine_decision",
          "machine_score",
          "version",
          "created_at_utc",
          "updated_at_utc"
        ],
        "title": "ReviewCaseSummary",
        "type": "object"
      },
      "ReviewEventRead": {
        "additionalProperties": false,
        "description": "One entry of a case's append-only history, oldest first.",
        "properties": {
          "event_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "event_type": {
            "$ref": "#/components/schemas/ReviewEventType"
          },
          "is_resolution": {
            "title": "Is Resolution",
            "type": "boolean"
          },
          "occurred_at_utc": {
            "title": "Occurred At Utc",
            "type": "string"
          },
          "resolution_sequence": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution Sequence"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          },
          "suggestion_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggestion Id"
          }
        },
        "required": [
          "event_id",
          "event_type",
          "occurred_at_utc",
